# AI Referee - esempio di configurazione locale
# Copiare questo file come backend/.env e inserire le proprie chiavi API.
# Non inserire mai chiavi reali in questo file di esempio.

# Database MongoDB locale (obbligatorio)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=aireferee

# Modalita di esecuzione: impostare true solo per una demo esplicita
USE_MOCK=false

# Provider attivi
ENABLE_OPENAI=true
ENABLE_GEMINI=true
ENABLE_MISTRAL=false
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=45
MISTRAL_MAX_RETRIES=2
PRIMARY_PROVIDER=gemini

# Limite massimo indipendente per l'intera chiamata di ogni provider.
PROVIDER_TIMEOUT_SECONDS=60
# Override opzionali (se assenti usano PROVIDER_TIMEOUT_SECONDS).
# OPENAI_PROVIDER_TIMEOUT_SECONDS=60
# GEMINI_PROVIDER_TIMEOUT_SECONDS=60
# MISTRAL_PROVIDER_TIMEOUT_SECONDS=60

# Provider non ancora attivi
ENABLE_CLAUDE=false
ENABLE_GROK=false

# Modello usato per la Trusted Conclusion
SYNTH_MODEL=gpt-5.4-mini
# Diagnostica sicura della sola forma del payload; lasciare false normalmente.
AI_REFEREE_TRACE_CONCLUSION=false

# Accesso locale del frontend React. Lista separata da virgole, oppure "*"
# per qualunque origine (default se la variabile non e' impostata: "*" —
# invariato per non rompere deployment esistenti senza configurazione
# esplicita). In produzione (es. Vercel) impostare esplicitamente il dominio
# reale del frontend, es: CORS_ORIGINS=https://aireferee.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Deve restare "false" a meno che il backend non introduca in futuro
# un'autenticazione basata su cookie/sessione browser: oggi l'identita' e
# l'accesso admin passano da semplici header (X-User-Id, X-Admin-Token) che
# non richiedono la modalita' "credentials" del CORS. Impostare a "true"
# insieme a un CORS_ORIGINS non-wildcard solo se davvero necessario.
CORS_ALLOW_CREDENTIALS=false

# Lunghezza massima (in caratteri) del prompt accettata dal backend.
# Applicata prima di qualsiasi chiamata a provider, embedding, traduzione o
# sintesi (vedi backend/server.py, MAX_PROMPT_LENGTH).
MAX_PROMPT_LENGTH=4000

# Smart Reuse (valori predefiniti del progetto)
REUSE_SIM_NEAR_EXACT=0.95
REUSE_SIM_STRONG=0.88
SMART_REUSE_THRESHOLD=0.55
REUSE_SAVED_COST=0.00030
REUSE_SAVED_LATENCY_MS=8000

# Funzioni future/opzionali; lasciare commentate finche non servono.
# ADMIN_TOKEN=
# USER_KEY_ENCRYPTION_KEY=
